APP_NAME=history-mapped
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Laravel Octane (FrankenPHP). The production image always passes
# --server=frankenphp; this keeps local `octane:start` consistent.
OCTANE_SERVER=frankenphp

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=history-mapped
DB_USERNAME=history-mapped
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@history-mapped.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=anthropic/claude-haiku-4.5

VITE_APP_NAME="${APP_NAME}"
VITE_ADMIN_DEV_SERVER_URL=http://localhost:5174

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:8000

# OpenAPI docs (Scramble) — served at /docs/api and /docs/api.json.
# Always open in local dev. In other environments the docs require the `viewApiDocs`
# gate (admin role); set this to true to make them fully public.
SCRAMBLE_DOCS_PUBLIC=false
API_VERSION=1.0.0

# openAI API key for the OpenRouter provider. This is a free key that is rate-limited to 100 requests per day.
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=mistralai/mistral-medium-3.1
OPENROUTER_API_KEY=

# Requests a minute to /api, per user or else per client IP.
# API_RATE_LIMIT=600

# ── OAuth keys for the MCP contributor server (/mcp/contribute, Laravel Passport) ──
# Local dev: `php artisan passport:keys` is enough; leave these empty.
# An RSA key pair that signs and verifies the access tokens Claude receives. Without them a
# request to /mcp/contribute is a 500, not a 401. Generate once, keep the private key secret
# (never commit it), and keep the same pair across deploys (changing it signs everyone out):
#   openssl genrsa -out /tmp/oauth-private.pem 4096
#   openssl rsa -in /tmp/oauth-private.pem -pubout -out /tmp/oauth-public.pem
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' /tmp/oauth-private.pem   # one line, \n for newlines
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' /tmp/oauth-public.pem
#   shred -u /tmp/oauth-private.pem /tmp/oauth-public.pem
# then paste each line inside double quotes. (Locally, `php artisan passport:keys` writes
# storage/oauth-*.key instead, readable by the web user; the env values win when set.)
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
