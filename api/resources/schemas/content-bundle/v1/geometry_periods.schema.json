{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-mapped.local/schemas/content-bundle/v1/geometry_periods.schema.json",
  "title": "Geometry period line",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "entity_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "period_type": {
      "type": "string"
    },
    "start_year": {
      "$ref": "common.schema.json#/$defs/year"
    },
    "end_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "enum": [
            "high",
            "medium",
            "low",
            "unresolved"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_mode": {
      "enum": [
        "derived",
        "manual",
        "ohm_import"
      ]
    },
    "relationship_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_event_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "geom": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/geometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "territory_geom": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/geometry"
        },
        {
          "type": "null"
        }
      ]
    },
    "_op": {
      "$ref": "common.schema.json#/$defs/op"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "_op": {
            "const": "delete"
          }
        },
        "required": [
          "_op"
        ]
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "entity_id",
          "period_type",
          "start_year",
          "provenance_mode"
        ]
      }
    }
  ]
}
