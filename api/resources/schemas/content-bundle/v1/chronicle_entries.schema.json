{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-mapped.local/schemas/content-bundle/v1/chronicle_entries.schema.json",
  "title": "Chronicle entry line",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "chronicle_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sequence_order": {
      "type": "integer"
    },
    "start_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "impact_score": {
      "type": [
        "integer",
        "null"
      ]
    },
    "primary_relationship_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "narrative_text": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "approximate_location": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_evidence": {},
    "generated_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "role": {
            "enum": [
              "participant",
              "mentioned",
              "location",
              "outcome"
            ]
          },
          "sequence_in_entry": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "entity_id"
        ]
      }
    },
    "_op": {
      "$ref": "common.schema.json#/$defs/op"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "_op": {
            "const": "delete"
          }
        },
        "required": [
          "_op"
        ]
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "chronicle_id",
          "narrative_text"
        ]
      }
    }
  ]
}
