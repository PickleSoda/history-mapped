{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-mapped.local/schemas/content-bundle/v1/entities.schema.json",
  "title": "Entity line",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "political_entity",
        "dynasty",
        "person",
        "military_unit",
        "diplomatic_relationship",
        "social_class",
        "city",
        "infrastructure_monument",
        "extraction_infra",
        "educational_institution",
        "event_war",
        "event_battle",
        "event_treaty",
        "event_rebellion",
        "event_natural_disaster",
        "event_tech_adoption",
        "event_legal_reform",
        "migration",
        "epidemic_disease",
        "trade_route",
        "natural_resource",
        "currency_monetary_system",
        "cultural_work",
        "intellectual_movement",
        "archaeological_culture",
        "language",
        "religious_text",
        "legal_code",
        "religious_movement",
        "technology"
      ]
    },
    "wikidata_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/qid"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "significance": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact_score": {
      "type": [
        "integer",
        "null"
      ]
    },
    "display_priority": {
      "type": [
        "integer",
        "null"
      ]
    },
    "icon_class": {
      "anyOf": [
        {
          "enum": [
            "crown",
            "person",
            "dynasty_tree",
            "sword",
            "city",
            "monument",
            "trade_ship",
            "gem",
            "pickaxe",
            "coin",
            "people",
            "migration_arrow",
            "plague",
            "handshake",
            "scroll",
            "palette",
            "ruins",
            "language_glyph",
            "sacred_book",
            "scales",
            "crossed_swords",
            "shield",
            "treaty_seal",
            "fist",
            "earthquake",
            "gear",
            "quill",
            "temple",
            "lightbulb",
            "university"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_status": {
      "enum": [
        "pipeline_draft",
        "ohm_draft",
        "auto_validated",
        "needs_review",
        "in_review",
        "human_verified",
        "expert_verified",
        "flagged",
        "rejected",
        "merged"
      ]
    },
    "date_method": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date_method"
        },
        {
          "type": "null"
        }
      ]
    },
    "date_confidence": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_type": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/duration_type"
        },
        {
          "type": "null"
        }
      ]
    },
    "location_method": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/location_method"
        },
        {
          "type": "null"
        }
      ]
    },
    "location_confidence": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "primary_geo_ref_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": "object"
    },
    "source_citations": {
      "type": [
        "object",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_primary": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/tag"
      }
    },
    "temporal_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "range_type": {
            "type": "string"
          },
          "start_year": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/year"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_year": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/year"
              },
              {
                "type": "null"
              }
            ]
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_type": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/duration_type"
              },
              {
                "type": "null"
              }
            ]
          },
          "date_method": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/date_method"
              },
              {
                "type": "null"
              }
            ]
          },
          "date_confidence": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/confidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_primary": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location_method": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/location_method"
              },
              {
                "type": "null"
              }
            ]
          },
          "location_confidence": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/confidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_primary": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "geom": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/geometry"
              },
              {
                "type": "null"
              }
            ]
          },
          "territory_geom": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/geometry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "_op": {
      "$ref": "common.schema.json#/$defs/op"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "_op": {
            "const": "delete"
          }
        },
        "required": [
          "_op"
        ]
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "name",
          "entity_type"
        ]
      }
    }
  ]
}
