{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-mapped.local/schemas/content-bundle/v1/geo_refs.schema.json",
  "title": "Geo ref line",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "entity_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "provider": {
      "enum": [
        "ohm",
        "wikidata",
        "geonames",
        "pleiades",
        "custom"
      ]
    },
    "external_type": {
      "enum": [
        "node",
        "way",
        "relation",
        "feature",
        "qid"
      ]
    },
    "external_id": {
      "type": "string"
    },
    "match_role": {
      "enum": [
        "primary",
        "candidate",
        "fallback",
        "rejected"
      ]
    },
    "retrieval_method": {
      "enum": [
        "overpass",
        "nominatim",
        "rest",
        "manual"
      ]
    },
    "temporal_start": {
      "type": [
        "string",
        "null"
      ]
    },
    "temporal_end": {
      "type": [
        "string",
        "null"
      ]
    },
    "temporal_start_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal_end_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "geometry_period_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "match_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "is_active": {
      "type": "boolean"
    },
    "external_tags": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_meta": {
      "type": [
        "object",
        "null"
      ]
    },
    "_op": {
      "$ref": "common.schema.json#/$defs/op"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "_op": {
            "const": "delete"
          }
        },
        "required": [
          "_op"
        ]
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "entity_id",
          "provider",
          "external_type",
          "external_id",
          "match_role",
          "retrieval_method"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "_op": {
            "const": "replace"
          }
        },
        "required": [
          "_op"
        ]
      },
      "then": {
        "required": [
          "entity_id",
          "provider",
          "external_type",
          "external_id",
          "match_role",
          "retrieval_method"
        ]
      }
    }
  ]
}
