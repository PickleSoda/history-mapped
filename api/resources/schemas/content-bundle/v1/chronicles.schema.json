{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-mapped.local/schemas/content-bundle/v1/chronicles.schema.json",
  "title": "Chronicle line",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "title": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "video_transcript",
        "article",
        "book_excerpt",
        "manual"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "start_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_year": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/year"
        },
        {
          "type": "null"
        }
      ]
    },
    "impact_score": {
      "type": [
        "integer",
        "null"
      ]
    },
    "approximate_location": {
      "type": [
        "object",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/tag"
      }
    },
    "_op": {
      "$ref": "common.schema.json#/$defs/op"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "_op": {
            "const": "delete"
          }
        },
        "required": [
          "_op"
        ]
      },
      "then": {
        "required": [
          "id"
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "title",
          "slug",
          "source_type"
        ]
      }
    }
  ]
}
