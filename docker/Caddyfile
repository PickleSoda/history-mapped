# Caddy edge proxy for the production droplet stack.
# Auto-provisions and renews Let's Encrypt TLS for both domains.
#
# $APP_DOMAIN / $WEB_DOMAIN are injected from docker/.env.prod via
# docker-compose.prod.yml. For a local/staging host without public domains,
# replace the site addresses with ":80" / ":8081" to serve plain HTTP.

{
	servers {
		# Both domains sit behind Cloudflare's proxy, so the peer is a Cloudflare
		# edge server. Take the visitor's address from CF-Connecting-IP, but only
		# when the connection really comes from Cloudflare; a direct caller's
		# header is ignored and {client_ip} stays the peer address.
		# Ranges: https://www.cloudflare.com/ips/ (they change rarely; a stale
		# list only means some visitors are seen as a Cloudflare address).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Every proxy to the app sends `header_up X-Forwarded-For {client_ip}`. Laravel
# trusts its peer (this proxy) and reads the client from X-Forwarded-For, taking
# the last address it does not trust. Left to the default, a request through
# Cloudflare would carry "visitor, cloudflare-edge" and every per-IP rate limit
# would key on the edge server; this sends the visitor alone.

# Tile upstreams, one per TILES_DRIVER value (see the /tiles/* handler).
(tiles-martin) {
	reverse_proxy martin:3000
}
(tiles-app) {
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}

# API + admin (Inertia) + OpenAPI docs — the FrankenPHP/Octane app on :8080.
{$APP_DOMAIN} {
	# The AI chat endpoint streams Server-Sent Events (text/event-stream). The
	# `encode` directive buffers the whole response to compress it, which defeats
	# incremental streaming (the browser only sees tokens once the stream closes).
	# Route SSE through its own handler with no compression and immediate flushing.
	# NOTE: Octane's own FrankenPHP Caddyfile must ALSO skip compression for this
	# path — see docker/api/octane-Caddyfile.
	@sse path /ai/chat
	handle @sse {
		reverse_proxy app:8080 {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}

	# Vector tiles for the public atlas. Short TTL: tiles follow the data.
	# TILES_DRIVER (docker/.env.prod, default martin) picks who answers:
	# the Martin sidecar, or the app serving the same functions at the same
	# URLs (routes/tiles.php). Caddy reads it at start: recreate after a change.
	@tiles path /tiles/*
	handle @tiles {
		header Cache-Control "public, max-age=300"
		encode zstd gzip
		import tiles-{$TILES_DRIVER:martin}
	}

	handle {
		encode zstd gzip
		reverse_proxy app:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Public customer SPA — static files built into the web_dist volume.
{$WEB_DOMAIN} {
	encode zstd gzip
	# The web-dist service installs each CI-built bundle as releases/<sha> and
	# points this symlink at it (docker/web/install-web-dist.sh).
	root * /srv/web/current
	# Cloudflare caches files by extension (two hours at the edge) and tells
	# browsers to keep them four hours when the origin names no lifetime. The
	# service worker points at the current build, so it must be revalidated on
	# every check or a release stays unseen until those copies expire. Hashed
	# files under /assets/ are safe to keep.
	header /sw.js Cache-Control "no-cache"
	# Cloudflare also caches .txt by extension: an hour, so an edit to either
	# file reaches crawlers the same day.
	header /robots.txt Cache-Control "public, max-age=3600"
	header /llms.txt Cache-Control "public, max-age=3600"

	# Entity and chronicle pages. index.html is an empty shell until the web
	# app starts, so a reader that runs no JavaScript (most AI crawlers, link
	# previews) would get nothing. The app answers these with that same
	# index.html, the page's title, description and text written into it
	# (api/routes/site.php), and the web app takes over once it has loaded.
	# Its not-found page (404) passes through. If the app fails or is away
	# (a deploy restarts it), the plain shell is served as before: these pages
	# must never depend on the app being up.
	@site_pages path /entities/* /chronicles/*
	handle @site_pages {
		reverse_proxy app:8080 {
			rewrite /site-pages{uri}
			header_up X-Forwarded-For {client_ip}
			@app_failed status 5xx
			handle_response @app_failed {
				rewrite * /index.html
				file_server
			}
		}
	}

	# The sitemap is generated by the app from the database. No fallback here:
	# a crawler should see the error and come back, not read index.html as XML.
	@sitemap path /sitemap.xml /sitemaps/*
	handle @sitemap {
		reverse_proxy app:8080 {
			rewrite /site-pages{uri}
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		try_files {path} /index.html   # SPA client-side routing
		file_server
	}

	# The app container cannot be reached (502-504 come from this proxy, not
	# from the app): serve the plain shell for the page paths above.
	handle_errors 502 503 504 {
		handle @site_pages {
			rewrite * /index.html
			file_server {
				status 200
			}
		}
	}
}
