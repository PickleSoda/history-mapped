# Production environment for docker/docker-compose.prod.yml.
# Copy to docker/.env.prod and fill in. NEVER commit the real .env.prod.

# ── Image to run (published by CI to GHCR; lowercase owner) ──────────────────
APP_IMAGE=ghcr.io/picklesoda/history-mapped/api:latest

# ── Public domains (Caddy provisions TLS for each) ───────────────────────────
APP_DOMAIN=api.example.org      # API + admin (Inertia) + /docs  -> app container
WEB_DOMAIN=app.example.org      # customer SPA (static, built by CI into the web image)

# ── Laravel app ──────────────────────────────────────────────────────────────
APP_NAME=history-mapped
APP_ENV=production
APP_DEBUG=false
# Generate once with:  docker run --rm ghcr.io/picklesoda/history-mapped/api:latest php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
APP_URL=https://api.example.org
LOG_CHANNEL=stderr
OCTANE_SERVER=frankenphp

# ── Database (the in-stack `db` service; or point at managed Postgres) ───────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=history-mapped
DB_USERNAME=history-mapped
# Also interpolated into Martin's connection URL: keep it URL-safe (letters, digits, - _ . ~) or percent-encode it.
DB_PASSWORD=REPLACE_ME_STRONG_PASSWORD
# These three configure the `db` container itself — keep them in sync with DB_* above.
POSTGRES_DB=history-mapped
POSTGRES_USER=history-mapped
POSTGRES_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# ── Cache / queue / session (the in-stack `redis` service) ───────────────────
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── Vector tiles: who answers APP_DOMAIN/tiles/* ────────────────────────────
# Both drivers serve the same tiles.* database functions at the same URLs
# (docs/schemas/atlas-tiles.md); switching needs no SPA rebuild.
#   martin  (default) the Martin sidecar: Rust, its own connection pool and an
#           in-memory tile cache. docker/compose-prod.sh turns this value into
#           the `martin` compose profile, so plain `docker compose` would not
#           start it: always go through the wrapper.
#   app     the Laravel app serves them (api/routes/tiles.php, 5-min cache in
#           CACHE_STORE). One container fewer, but tile requests then share
#           Octane's PHP workers (one per vCPU) with the API.
# After a change: `bash docker/compose-prod.sh up -d --remove-orphans`, then
# recreate caddy (it reads the value at start); with app, also `rm -sf martin`.
TILES_DRIVER=martin

# ── Public SPA build ─────────────────────────────────────────────────────────
# The SPA is built by CI into the `web` image, not on this host, so its VITE_*
# values are GitHub repository variables (Settings → Secrets and variables →
# Actions → Variables), not lines here:
#   VITE_API_URL        required; the API origin the browser calls (https://APP_DOMAIN,
#                       no /api/v1 path, no trailing slash)
#   VITE_MAP_TILES_URL  https://APP_DOMAIN/tiles switches the atlas to Martin vector
#                       tiles; unset keeps the REST GeoJSON overlay
#   VITE_APP_NAME       optional (default history-mapped)
#   VITE_ADMIN_ORIGINS  optional; extra origins allowed to drive the map-story
#                       editor's SPA preview (the API origin is trusted by default)
# Changing one takes effect on the next push to main (the image is rebuilt).

# ── SPA auth / CORS (cookie-based Sanctum; SPA + API live on two subdomains) ─
SANCTUM_STATEFUL_DOMAINS=app.example.org
FRONTEND_URL=https://app.example.org
# Auth cookies span api.* and app.*, so the session + XSRF-TOKEN cookies MUST be
# scoped to the shared PARENT domain (note the leading dot) — otherwise the SPA's
# JS can't read XSRF-TOKEN and every POST fails with 419. Secure is required over
# HTTPS; lax is fine because the subdomains are same-site.
SESSION_DOMAIN=.example.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Mail (password resets, notifications) ────────────────────────────────────
# Defaults to `log` so nothing breaks out of the box (mail is written to the app
# log instead of sent). Switch MAIL_MAILER=smtp and fill the rest to send real
# email to users.
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@example.org
MAIL_FROM_NAME=history-mapped

# ── OpenAPI docs (Scramble) — admin-gated unless set true ────────────────────
SCRAMBLE_DOCS_PUBLIC=false

# ── AI / OpenRouter ─────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=mistralai/mistral-medium-3.1
OPENROUTER_API_KEY=