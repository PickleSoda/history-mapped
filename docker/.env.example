# Host ports and DB credentials for the dev stack. Copy to docker/.env: Compose
# reads the .env beside docker-compose.yml, not one at the repository root.
# Every value here is the default, so set only what you need to change.
COMPOSE_PROJECT_NAME=history-mapped
FORWARD_NGINX_PORT=8000
FORWARD_WEB_PORT=5173
FORWARD_ADMIN_PORT=5174
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=8025
FORWARD_MARTIN_PORT=3000
FORWARD_CLOUDBEAVER_PORT=8978
FORWARD_REDISINSIGHT_PORT=5540
POSTGRES_DB=history-mapped
POSTGRES_USER=history-mapped
POSTGRES_PASSWORD=secret
